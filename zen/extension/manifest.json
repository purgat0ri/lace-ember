{
  "manifest_version": 2,
  "name": "Lace & Ember Start",
  "version": "1.3",
  "description": "The Lace & Ember start page as Zen's new tab and home page.",
  "browser_specific_settings": {
    "gecko": {
      "id": "lace-ember-start@local"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "chrome_settings_overrides": {
    "homepage": "newtab.html"
  },
  "icons": {
    "48": "img/sigil.svg",
    "96": "img/sigil.svg"
  }
}
